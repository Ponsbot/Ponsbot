# Use a brand-new Convex project. Never point this copy at the old deployment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# X reply bot (leave disabled until the new account is approved).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_REPLIES_ENABLED=false
X_REPLY_USER_DAILY_LIMIT=30
X_REPLY_GLOBAL_DAILY_LIMIT=250
X_REPLY_USER_WINDOW_LIMIT=5
X_REPLY_GLOBAL_WINDOW_LIMIT=25
X_REPLY_WINDOW_MINUTES=10
X_REPLY_COOLDOWN_SECONDS=30

# Natural-language command parsing.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-oss-20b

# Public site URL. The local signer route defaults to
# ${NEXT_PUBLIC_SITE_URL}/api/wallet-signer in application code; .env itself
# does not perform variable interpolation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wallet signer. Leave WALLET_SIGNER_URL blank to use the site route above, or
# set an explicit HTTPS URL when the signer is deployed as an isolated service.
# Keep execution disabled until its Pons V2 policy is reviewed.
X_CRYPTO_EXECUTION_ENABLED=false
WALLET_SIGNER_URL=
WALLET_SIGNER_TOKEN=
WALLET_SIGNER_IDEMPOTENCY_SECRET=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
WALLET_MAX_TRANSACTION_USD=10000

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_V2_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_V2_LAUNCH_AND_BUY_ROUTER=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
# Comma-separated ERC-20 candidate addresses. Each is checked on-chain before
# being shown; ETH is always represented by the zero address and needs no entry.
PONS_V2_PAIR_CANDIDATES=
# Confirm the live config and economics immediately before enabling execution.
PONS_LAUNCH_CONFIG_ID=
