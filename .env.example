# Convex deployment used by Ponsbot.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# X reply bot (leave disabled until the new account is approved).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
# Website "My Wallet" authentication. Configure the exact X OAuth 2.0 callback:
# https://your-domain.example/api/auth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Same long random value in Vercel and Convex. It authorizes the verified
# website callback to provision or retrieve the matching X user's wallet.
WEB_AUTH_SECRET=
X_REPLIES_ENABLED=false
# Convex only. Temporarily silence insufficient-ETH, launch X/verification
# restrictions, AI ambiguity and "This request did not complete" responses.
# Wallet checks and terminal messages are unaffected. No later backfill.
X_SUPPRESS_ROUTINE_FAILURE_REPLIES=false
X_STANDALONE_MENTIONS_ENABLED=false
# Unix timestamp in milliseconds. Standalone mode ignores interactions created before this point.
X_STANDALONE_MENTIONS_SINCE_MS=0
# Set false to pause standalone graduation announcements while leaving replies on.
X_GRADUATION_POSTS_ENABLED=true
X_REPLY_USER_DAILY_LIMIT=5000
X_REPLY_PREMIUM_DAILY_LIMIT=5000
X_REPLY_GLOBAL_DAILY_LIMIT=50000
X_REPLY_USER_WINDOW_LIMIT=10
X_REPLY_GLOBAL_WINDOW_LIMIT=500
# Legacy operator publication-budget scale; not the durable publication queue
# or the fixed per-user wallet-lookup admission window.
# Ready replies use 3 posts per rolling 2 minutes; group C one per 3 minutes.
# A has no age limit; B expires after 10 minutes, C after 7 minutes.
X_REPLY_BUDGET_SCALE=0.5
# Temporary API-side read filtering. Switching either way starts fresh intake.
X_READ_EXCLUDE_WALLET_BALANCE=false
X_READ_VERIFIED_ONLY=false
# Independent case-insensitive exact phrase exclusion at the X search API.
# Remains enabled if broader wallet/balance or automatic filters are removed.
X_READ_EXCLUDE_SHOW_MY_WALLET=false
# Convex only. Opt-in automatic read protection: 60 distinct incoming posts in
# 10 minutes adds missing -wallet -balance / is:verified filters for three hours.
# Each filter has independent automatic ownership and expiry. Manual filters
# are never removed; manually enabling an auto filter takes over its ownership.
# Leave false until explicitly activating. No timer starts while disabled.
X_AUTO_INTAKE_GUARD_ENABLED=false
X_REPLY_WINDOW_MINUTES=10
X_REPLY_COOLDOWN_SECONDS=0
# X wallet-address lookups: one accepted request per user per rolling 10 minutes.
# Excess requests are silently rejected, not queued. No global wallet, balance,
# or help category admission caps. Ready replies use the priority queue above.
# Liquidity workflows bypass internal X admission counters; ownership checks,
# API-side intake filters, wallet safety and shared publication pacing remain.

# Natural-language command parsing.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
OPENROUTER_STRUCTURED_OUTPUTS_ENABLED=true

# Public site URL. The local signer route defaults to
# ${NEXT_PUBLIC_SITE_URL}/api/wallet-signer in application code; .env itself
# does not perform variable interpolation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional rollout switch. Set true to report CSP violations without enforcing
# them; leave false in production after validation.
CSP_REPORT_ONLY=false

# Wallet signer. Leave WALLET_SIGNER_URL blank to use the site route above, or
# set an explicit HTTPS URL when the signer is deployed as an isolated service.
# Keep execution disabled until its Pons V2 policy is reviewed.
X_CRYPTO_EXECUTION_ENABLED=false
WALLET_SIGNER_URL=
WALLET_SIGNER_TOKEN=
WALLET_SIGNER_IDEMPOTENCY_SECRET=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Set enabled in both Vercel and Convex. Set total slots in Convex only.
# The dedicated CDP account sends the estimated Pons launch fee and buffered
# gas requirement, plus a 20% margin, to an eligible user's
# Pons Bot wallet for launch/network costs. Users still fund their own dev buy.
FREE_LAUNCH_SPONSOR_ENABLED=false
FREE_LAUNCH_TOTAL_SLOTS=0
FREE_LAUNCH_SPONSOR_CDP_ACCOUNT_NAME=ponsbot-free-launch-sponsor

# Automated creator-fee buyback and burn. This is an unreleased backend-only
# system and must remain false until the fee-vault contracts are deployed,
# verified, audited, and explicitly enrolled. When false, no new automatic fee
# cycle or public enrollment/controller command begins. Persisted enrollments
# and controller changes may still be reconciled so an already-broadcast
# transaction cannot leave fee rights or beneficiary funds in an unknown state.
AUTOMATED_BUYBACK_BURN_ENABLED=false
# Independent capability switches. The master switch above must also be true.
# Keep every switch false until that capability has passed its own rollout review.
AUTOMATED_FEE_SWEEP_BUYBACK_BURN_ENABLED=false
AUTOMATED_FEE_NEW_LAUNCH_ENROLLMENT_ENABLED=false
AUTOMATED_FEE_EXISTING_LAUNCH_UPGRADE_ENABLED=false
AUTOMATED_FEE_BOT_COMMANDS_ENABLED=false
# Same long random value in Convex and Vercel. It authenticates production
# enrollment, controller, and recovery calls independently of public switches.
AUTOMATED_FEE_ENROLLMENT_SECRET=
# Populated only after audited Robinhood Chain deployments exist.
AUTOMATED_FEE_VAULT_FACTORY_ADDRESS=
AUTOMATED_FEE_VAULT_IMPLEMENTATION_ADDRESS=
AUTOMATED_FEE_EXECUTION_ADAPTER_ADDRESS=
AUTOMATED_FEE_NATIVE_BUYBACK_EXECUTOR_ADDRESS=
AUTOMATED_FEE_PAIRED_BUYBACK_EXECUTOR_ADDRESS=
AUTOMATED_FEE_ADMIN_ADDRESS=
AUTOMATED_FEE_KEEPER_ADDRESS=
# Must be a separate operational signing authority from the keeper. It signs
# exact one-time EIP-712 swap bounds but cannot submit processing transactions.
AUTOMATED_FEE_QUOTE_AUTHORIZER_ADDRESS=
AUTOMATED_FEE_QUOTE_CDP_ACCOUNT_NAME=ponsbot-automated-fee-quotes
AUTOMATED_FEE_KEEPER_CDP_ACCOUNT_NAME=ponsbot-automated-fee-keeper
AUTOMATED_FEE_ADMIN_CDP_ACCOUNT_NAME=ponsbot-automated-fee-admin
AUTOMATED_FEE_PAUSE_GUARDIAN_ADDRESS=
AUTOMATED_FEE_CONTROL_ADDRESS=
AUTOMATED_FEE_MANUAL_TEST_ENABLED=false
# Private operator testing only. Existing token contracts only; never populated by launches.
AUTOMATED_FEE_MANUAL_TEST_TOKEN_ADDRESSES=
AUTOMATED_FEE_MANUAL_TEST_VAULT_ADDRESS=
AUTOMATED_FEE_PRIVATE_TEST_LAUNCHER_ADDRESS=
AUTOMATED_FEE_QUOTE_SLIPPAGE_BPS=300
AUTOMATED_FEE_V3_ROUTER_ADDRESS=0xcaf681a66d020601342297493863e78c959e5cb2
AUTOMATED_FEE_V3_QUOTER_ADDRESS=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
AUTOMATED_FEE_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
PONSBOT_TOKEN_ADDRESS=0xB1E9b822b81bbbdab375F7f4D86e44fA04d12b07
PONS_HOLDER_DISTRIBUTOR_FACTORY_ADDRESS=

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional website-only read RPC. Wallet execution continues using ROBINHOOD_RPC_URL.
WEBSITE_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_V2_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
MARKET_INDEX_SECRET=replace-with-the-same-long-random-secret-in-vercel-and-convex
# Paid CoinGecko API. Set the same server-only Pro API key in Vercel and
# Convex because website market reads and background workers run separately.
# Despite the paid plan being named Basic, paid keys use the Pro API hostname
# and x-cg-pro-api-key header. Runtime use begins only after the paid client,
# usage accounting, fallback behavior, and tests are implemented.
COINGECKO_PRO_API_KEY=
# Safety ceiling below the Basic plan's 100,000 monthly request allowance.
COINGECKO_PAID_MONTHLY_REQUEST_LIMIT=90000
PONS_V4_QUOTER_ADDRESS=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
PONS_V4_UNIVERSAL_ROUTER_ADDRESS=0x8876789976decbfcbbbe364623c63652db8c0904
PONS_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
PONS_V4_STATE_VIEW_ADDRESS=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
# Contract and pair-token addresses are maintained in the Convex registries.
PONS_LAUNCH_CONFIG_ID=

# Houdini Partner API. Keep the API secret server-side in Vercel.
HOUDINI_PARTNER_ID=
HOUDINI_API_SECRET=
HOUDINI_X402_ENABLED=false
HOUDINI_X402_CDP_ACCOUNT_NAME=ponsbot-houdini-x402
HOUDINI_X402_SESSION_LIMIT_USD=1
# Total x402 spending ceiling shared by terminal and X sessions per UTC day.
HOUDINI_X402_GLOBAL_DAILY_LIMIT_USD=10
HOUDINI_X402_AUDIT_SECRET=
# Same random server-only value in Vercel and Convex. It authorizes the X
# workflow to use the Vercel-hosted CDP x402 fallback after partner quota exhaustion.
HOUDINI_X_RELAY_SECRET=

# Deprecated foundation-scaffold flag. It does not enable, disable, or restrict
# the authenticated public X and terminal liquidity workflow.
LIQUIDITY_ENABLED=false
# Private liquidity quote authentication. Set only on the Vercel signer (and
# local signer development), NOT Convex; use a distinct random 32+ character key.
LIQUIDITY_QUOTE_SIGNING_SECRET=
