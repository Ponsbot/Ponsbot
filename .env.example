# Convex deployment used by Ponsbot.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# X reply bot (leave disabled until the new account is approved).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
# Website "My Wallet" authentication. Configure the exact X OAuth 2.0 callback:
# https://your-domain.example/api/auth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Same long random value in Vercel and Convex. It authorizes the verified
# website callback to provision or retrieve the matching X user's wallet.
WEB_AUTH_SECRET=
X_REPLIES_ENABLED=false
# Set false to pause standalone graduation announcements while leaving replies on.
X_GRADUATION_POSTS_ENABLED=true
X_REPLY_USER_DAILY_LIMIT=75
X_REPLY_PREMIUM_DAILY_LIMIT=1500
X_REPLY_GLOBAL_DAILY_LIMIT=100000
X_REPLY_USER_WINDOW_LIMIT=20
X_REPLY_GLOBAL_WINDOW_LIMIT=1000
X_REPLY_WINDOW_MINUTES=10
X_REPLY_COOLDOWN_SECONDS=20

# Natural-language command parsing.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
OPENROUTER_STRUCTURED_OUTPUTS_ENABLED=true

# Public site URL. The local signer route defaults to
# ${NEXT_PUBLIC_SITE_URL}/api/wallet-signer in application code; .env itself
# does not perform variable interpolation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wallet signer. Leave WALLET_SIGNER_URL blank to use the site route above, or
# set an explicit HTTPS URL when the signer is deployed as an isolated service.
# Keep execution disabled until its Pons V2 policy is reviewed.
X_CRYPTO_EXECUTION_ENABLED=false
WALLET_SIGNER_URL=
WALLET_SIGNER_TOKEN=
WALLET_SIGNER_IDEMPOTENCY_SECRET=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
WALLET_MAX_TRANSACTION_USD=10000

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_V2_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
MARKET_INDEX_SECRET=replace-with-the-same-long-random-secret-in-vercel-and-convex
PONS_V4_QUOTER_ADDRESS=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
PONS_V4_UNIVERSAL_ROUTER_ADDRESS=0x8876789976decbfcbbbe364623c63652db8c0904
PONS_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
PONS_V4_STATE_VIEW_ADDRESS=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
# Contract and pair-token addresses are maintained in the Convex registries.
PONS_LAUNCH_CONFIG_ID=
